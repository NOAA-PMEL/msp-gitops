[
    {
        "version": "envds.sampling.modes/v1",
        "kind": "SamplingMode",
        "metadata": {
            "name": "beacons_location_power",
            "sampling_namespace": "${SAMPLING_NAMESPACE}/${ENVOPS_DEPLOYMENT_REF}",
            "valid_config_time": "${MODES_REVISION_TIME}",
            "revision": 3
        },
        "requirements": [
            {
                "kind": "SamplingState",
                "name": "nominal_location"
            }
        ],
        "actions": {
            "true": [
                { "kind": "SamplingAction", "name": "turn_on_cpc" },
                { "kind": "SamplingAction", "name": "set_cpc_sampling" },
                { "kind": "SamplingAction", "name": "turn_on_opc" },
                { "kind": "SamplingAction", "name": "set_opc_sampling" },
                { "kind": "SamplingAction", "name": "turn_on_aps" },
                { "kind": "SamplingAction", "name": "set_aps_sampling" },
                { "kind": "SamplingAction", "name": "turn_on_smps" },
                { "kind": "SamplingAction", "name": "set_smps_sampling" },
                { "kind": "SamplingAction", "name": "set_absorb_sampling" }
            ],
            "false": [
                { "kind": "SamplingAction", "name": "set_cpc_idle" },
                { "kind": "SamplingAction", "name": "turn_off_cpc" },
                { "kind": "SamplingAction", "name": "set_opc_idle" },
                { "kind": "SamplingAction", "name": "turn_off_opc" },
                { "kind": "SamplingAction", "name": "set_aps_idle" },
                { "kind": "SamplingAction", "name": "turn_off_aps" },
                { "kind": "SamplingAction", "name": "set_smps_idle" },
                { "kind": "SamplingAction", "name": "turn_off_smps" },
                { "kind": "SamplingAction", "name": "set_absorb_idle" }
            ]
        }
    }
]